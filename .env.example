# ==============================================================================
# Event-Driven Autonomous Procurement Multi-Agent System - Environment Template
# ==============================================================================

# Google Gemini LLM Settings
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Alternative alias supported:
GOOGLE_API_KEY=your-gemini-api-key

# Kafka Messaging Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INVENTORY_EVENTS=inventory-events
KAFKA_TOPIC_RESTOCK_EVENTS=inventory-restock
KAFKA_CONSUMER_GROUP_ID=procurement-agent-group

# Kafka SASL Authentication (Optional - for Confluent Cloud, Upstash, AWS MSK, or password-protected brokers)
# KAFKA_SECURITY_PROTOCOL=SASL_SSL     # "SASL_SSL" (TLS encrypted) or "SASL_PLAINTEXT"
# KAFKA_SASL_MECHANISM=PLAIN          # "PLAIN", "SCRAM-SHA-256", or "SCRAM-SHA-512"
# KAFKA_USERNAME=your-kafka-api-key
# KAFKA_PASSWORD=your-kafka-api-secret
# Kafka SSL / CA Certificate (Optional - for custom CA / self-signed certificates or AWS MSK / Aiven)
# KAFKA_CA_LOCATION=/path/to/ca.pem    # Path to CA certificate file
# KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"


# Inventory Agent Feature Flags
INVENTORY_AGENT_ENABLED=true
# Or alias format:
# INVENTORY_AGENT=enabled

# PostgreSQL Checkpointer URI (for LangGraph state persistence)
POSTGRES_URI=postgresql://postgres:postgrespassword@localhost:5432/procurement_db

# Mock ERP Service URL
MOCK_ERP_URL=http://localhost:8002
# Production Mock ERP URL on Render:
# MOCK_ERP_URL=https://ecommerce-agents.onrender.com

# SMK E-Commerce Backend / Storefront API URL
SMK_SERVER_URL=http://localhost:4000/api
# Production E-Commerce Storefront on Vercel:
# SMK_SERVER_URL=https://smk-tan.vercel.app/api

# Slack Human-in-the-Loop (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_CHANNEL_ID=C0123456789

# Langfuse Observability (OpenTelemetry / Callbacks)
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=https://cloud.langfuse.com
